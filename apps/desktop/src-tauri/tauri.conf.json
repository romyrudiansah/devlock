{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevLock",
  "identifier": "dev.devlock.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevLock",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "DevLock",
    "copyright": "Copyright (c) 2026 Romy Rudiansah. MIT OR Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
